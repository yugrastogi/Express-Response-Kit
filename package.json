{
  "name": "express-response-kit",
  "version": "0.1.0",
  "description": "A lightweight response formatting utility for Express.js APIs",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
